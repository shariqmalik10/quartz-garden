{
  "name": "@shariq/kimi-thoughts",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/components/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "node ./build.mjs"
  },
  "quartz": {
    "name": "kimi-thoughts",
    "displayName": "Kimi Thoughts",
    "description": "A second photograph sketchbook whose ink — bolts, boats, butterflies, and handwritten labels — is drawn live with the Canvas 2D API, and whose sparkles stay awake afterwards.",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultEnabled": true,
    "components": {
      "KimiThoughts": {
        "displayName": "Kimi Thoughts sketchbook",
        "description": "Renders the doodled gallery on /model-sketchbooks/kimi.",
        "defaultPosition": "afterBody",
        "defaultPriority": 40
      }
    }
  }
}
