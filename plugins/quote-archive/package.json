{
  "name": "@shariq/quote-archive",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/components/index.js"
  },
  "main": "./dist/index.js",
  "quartz": {
    "name": "quote-archive",
    "displayName": "Quote Archive",
